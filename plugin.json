{
  "id": "fnos-music",
  "name": "fnOS Music",
  "version": "1.1.2",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": { "network": ["*"] },
  "requestHeaders": [
    {
      "hosts": ["{setting:server}"],
      "kinds": ["image"],
      "headers": { "cookie": "music-token={storage:token}" }
    }
  ],
  "settings": [
    {
      "key": "server",
      "label": "Server",
      "help": "Your fnOS Music address, such as https://fnos.example.com (without /music/login)."
    },
    {
      "key": "username",
      "label": "Username",
      "help": "Your fnOS Music username."
    },
    {
      "key": "password",
      "label": "Password",
      "help": "Your fnOS Music password. It is kept by MyGo Music and only sent to the server you set."
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "Songs", "page": "songs", "icon": "note" },
    { "builtin": "liked" },
    { "title": "Albums", "page": "albums", "icon": "album" },
    { "title": "Artists", "page": "artists", "icon": "artist" },
    { "title": "Playlists", "page": "playlists", "icon": "playlist" }
  ]
}
